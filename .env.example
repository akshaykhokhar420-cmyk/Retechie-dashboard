# Server-side URL of the Retechie API (used by Next rewrites; never exposed to the browser)
API_INTERNAL_URL=http://localhost:4000
# Origin that serves uploaded images (backend PUBLIC_MEDIA_BASE_URL origin) — allowed in the dashboard CSP
NEXT_PUBLIC_MEDIA_URL=http://localhost:4000/media
# The public storefront; used for the "Preview" buttons
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
